datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // e.g. DSA001, NBFC02
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  files     File[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PARTNER") // PARTNER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations for Partner roles
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // Relations for actions
  createdFiles  File[]          @relation("FileCreator")
  statusChanges StatusHistory[]
  escalations   Escalation[]
}

model File {
  id            String   @id // Custom unique human-readable ID (e.g. FL-2026-0001)
  applicantName String
  contactNumber String
  email         String
  fileType      String // e.g. HOME_LOAN, PERSONAL_LOAN, LAP, AUTO_LOAN
  partnerRefId  String? // Partner's internal tracking reference
  documentData  String? // Base64 document payload (PDF/Image)
  documentName  String? // Name of the uploaded file
  formData      String? // Serialized multi-step application JSON data
  status        String   @default("LOGGED") // LOGGED, IN_REVIEW, APPROVED, REJECTED, ON_HOLD, DISBURSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FileCreator", fields: [createdById], references: [id])

  statusHistory StatusHistory[]
  escalations   Escalation[]
}

model StatusHistory {
  id          String   @id @default(uuid())
  fileId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  remarks     String?
  createdAt   DateTime @default(now())
}

model Escalation {
  id         String    @id @default(uuid())
  fileId     String
  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type       String    @default("MANUAL") // AUTOMATED, MANUAL
  reason     String
  comments   String?
  status     String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  raisedById String?
  raisedBy   User?     @relation(fields: [raisedById], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
